# ── Server ─────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/hybrid_queue

# ── Redis ──────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT ────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_to_a_64_char_random_hex_string_access
JWT_REFRESH_SECRET=change_me_to_a_64_char_random_hex_string_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── OTP ────────────────────────────────────────────────────
OTP_EXPIRES_MINUTES=10

# ── Expiry Worker ──────────────────────────────────────────
EXPIRY_POLL_INTERVAL_SECONDS=30

# ── CORS ───────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:3000

# ── SMTP (Email — optional) ────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=yourpassword
SMTP_FROM="Hybrid Queue <noreply@example.com>"

# ── Twilio (SMS — optional) ────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
